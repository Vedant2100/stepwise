# Copy to .env (never commit .env). On Vercel, set these in Project Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Optional: model id (default claude-haiku-5-5, the cheapest API model)
STEPWISE_MODEL=
# Optional: if set, the app asks for this code before calling the model, so a public deployment can't spend your key.
STEPWISE_ACCESS_CODE=
